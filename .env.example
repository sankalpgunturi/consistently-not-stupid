# Consistently Not Stupid
# Copy to .env. The book runs in paper mode without any keys.
# Public Kalshi market data does not need a key.

CST_BANKROLL=1000
CST_HOST=127.0.0.1
CST_PORT=8000
CST_DATA_DIR=data

# Scan cadence and the probability bar. The desk can move these later,
# inside hard rails, after it has seen settled trades.
CST_MIN_PROBABILITY=0.90
CST_SCAN_INTERVAL_SECONDS=60
CST_ENTRY_WINDOW_MINUTES=10
CST_MIN_EDGE=0.01
CST_MIN_WIN_PROFIT=0.01
CST_MAX_SPREAD=0.03
CST_MAX_DAYS_TO_EXPIRY=21
CST_MIN_HOURS_TO_EXPIRY=2
CST_MIN_STABLE_SCANS=2
CST_MAX_POSITION_FRACTION=0.008
CST_MAX_DEPLOYED_FRACTION=0.40
CST_MAX_DRAWDOWN=0.05

# Optional. Without this, a fixed governor writes the retrospective.
CST_OPENAI_API_KEY=
CST_OPENAI_MODEL=gpt-4o-mini

# Unused. This build never places an order. Live sending is a later
# reviewed change, not a switch on this page.
CST_KALSHI_API_KEY_ID=
CST_KALSHI_PRIVATE_KEY_PATH=
