{
  "name": "consistently-not-stupid",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/internal/*", "/ws"]},
  "durable_objects": {"bindings": [{"name": "DESK", "class_name": "DeskSnapshot"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["DeskSnapshot"]}]
}
